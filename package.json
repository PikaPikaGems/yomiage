{
  "name": "yomiage",
  "version": "0.2.0",
  "description": "Japanese text-to-speech in the browser (Tsukuyomi-chan voice via piper-plus), with voice presets. Works on iPhone Safari.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/yomiage.js",
      "default": "./dist/yomiage.js"
    }
  },
  "bin": {
    "yomiage": "./bin/yomiage.mjs"
  },
  "files": [
    "dist/",
    "bin/",
    "types/",
    "API.md",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "files": "node scripts/make-files.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build",
    "test:types": "tsc -p test/types",
    "publish:demo": "node scripts/publish-demo.mjs",
    "test:webkit": "node test/webkit.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "kakera": "file:../kakera",
    "onnxruntime-web": "1.30.0",
    "piper-plus": "0.7.0",
    "playwright-core": "1.55.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "japanese",
    "tts",
    "text-to-speech",
    "piper",
    "tsukuyomi",
    "browser"
  ],
  "types": "./types/index.d.ts"
}
