{
  "name": "yomiage",
  "version": "0.1.0",
  "description": "Japanese text-to-speech in the browser (Tsukuyomi-chan voice via piper-plus), with voice presets. Works on iPhone Safari.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/yomiage.js"
  },
  "bin": {
    "yomiage": "./bin/yomiage.mjs"
  },
  "files": [
    "dist/",
    "bin/",
    "API.md",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "files": "node scripts/make-files.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "kakera": "file:../kakera",
    "onnxruntime-web": "1.30.0",
    "piper-plus": "0.7.0"
  },
  "keywords": ["japanese", "tts", "text-to-speech", "piper", "tsukuyomi", "browser"]
}
